<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="160dp"
    android:height="160dp"
    android:viewportWidth="160"
    android:viewportHeight="160">

    <!-- Ambient Center Glow -->
    <path
        android:pathData="M80,80m-60,0a60,60 0 1,1 120,0a60,60 0 1,1 -120,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="80"
                android:centerY="80"
                android:gradientRadius="60"
                android:type="radial">
                <item android:color="#330F62FE" android:offset="0.0"/>
                <item android:color="#1A8A3FFC" android:offset="0.55"/>
                <item android:color="#00080B11" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Ripple Wave Ring -->
    <path
        android:strokeColor="#304589FF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M80,80m-42,0a42,42 0 1,1 84,0a42,42 0 1,1 -84,0" />

    <!-- Mid Harmonic Ripple Ring -->
    <path
        android:strokeColor="#600F62FE"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:pathData="M80,80m-28,0a28,28 0 1,1 56,0a28,28 0 1,1 -56,0" />

    <!-- Inner Focused Ripple Ring -->
    <path
        android:strokeColor="#BB4589FF"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:pathData="M80,80m-16,0a16,16 0 1,1 32,0a16,16 0 1,1 -32,0" />

    <!-- Central Luminous Water Drop / Core Pebble Node -->
    <path
        android:pathData="M80,63 C75.5,69 70,76 70,82 C70,87.5 74.5,92 80,92 C85.5,92 90,87.5 90,82 C90,76 84.5,69 80,63 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="80"
                android:startY="63"
                android:endX="80"
                android:endY="92"
                android:type="linear">
                <item android:color="#4589FF" android:offset="0.0"/>
                <item android:color="#0F62FE" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Droplet Specular Reflection Highlight -->
    <path
        android:fillColor="#E6FFFFFF"
        android:pathData="M78,75 C78,72.5 79.2,69.5 80,67.5 C80.3,69.5 81.2,72 81.2,74.5 C81.2,76.2 79.8,77.5 78,77.5 C78,76.5 78,75.8 78,75 Z" />

</vector>
